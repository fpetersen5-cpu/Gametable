					"type": "file"
				},
				{
					"path": "modules/smoke-tts.py",
					"type": "file"
				},
				{
					"path": "modules/SPEECH-NOTICES.md",
					"type": "file"
				}
			],
			"build-commands": [
				"mkdir -p /app/piper/voices",
				"install -m644 en_US-libritts_r-medium.onnx en_US-libritts_r-medium.onnx.json /app/piper/voices/",
				"install -Dm644 MODEL_CARD /app/share/licenses/io.github.fpetersen5_cpu.GameTable/piper-voice/MODEL_CARD",
				"install -Dm644 SPEECH-NOTICES.md /app/share/doc/gametable/SPEECH-NOTICES.md",
