		{
			"name": "gametable",
			"buildsystem": "simple",
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/fpetersen5-cpu/Gametable.git",
					"commit": "94a9a88f8409e44bcc9f25f485a4fc614bf96d12"
				},
				"node-sources.json",
				{
					"dest": "flatpak-node/electron-cache/902aaaf97776b0cc78be070e68179849dc7cd5aca622b2a809146b1684b69562",
					"only-arches": [
						"x86_64"
					],
					"url": "https://github.com/electron/electron/releases/download/v44.9.3/electron-v44.9.3-linux-x64.zip",
					"sha256": "6e7fd2d450d442507b846ace4ae6e2bd17e1b1653e86a033b5231abfc23e6df4",
					"dest-filename": "electron-v44.9.3-linux-x64.zip",
					"type": "file"
				}
			],
			"build-options": {
				"env": {
					"XDG_CACHE_HOME": "/run/build/gametable/flatpak-node/cache",
					"npm_config_cache": "/run/build/gametable/flatpak-node/npm-cache",
					"npm_config_offline": "true",
					"npm_config_nodedir": "/usr/lib/sdk/node22",
					"electron_config_cache": "/run/build/gametable/flatpak-node/electron-cache"
				},
				"append-path": "/usr/lib/sdk/node22/bin"
			},
			"build-commands": [
				"npm ci",
				"node node_modules/electron/install.js",
				"npm run build -w @gametable/desktop",
				"mkdir -p /app/gametable",
				"cp -r apps/desktop/dist /app/gametable/dist",
				"cp -r node_modules/electron/dist /app/gametable/electron",
				"cp apps/desktop/package.json /app/gametable/package.json",
				"install -Dm755 flatpak/gametable.sh /app/bin/gametable",
				"install -Dm644 flatpak/io.github.fpetersen5_cpu.GameTable.metainfo.xml /app/share/metainfo/io.github.fpetersen5_cpu.GameTable.metainfo.xml",
				"install -Dm644 flatpak/io.github.fpetersen5_cpu.GameTable.desktop /app/share/applications/io.github.fpetersen5_cpu.GameTable.desktop",
				"install -Dm644 flatpak/io.github.fpetersen5_cpu.GameTable.svg /app/share/icons/hicolor/scalable/apps/io.github.fpetersen5_cpu.GameTable.svg",
				"install -Dm644 LICENSE /app/share/licenses/io.github.fpetersen5_cpu.GameTable/gametable/LICENSE"
			]
		}
	]
